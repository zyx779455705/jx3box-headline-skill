{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/jx3box-headline-skill/brief.schema.json",
  "title": "JX3BOX Headline Brief",
  "type": "object",
  "required": ["article_title", "main_title"],
  "properties": {
    "article_title": {"type": "string", "minLength": 1},
    "main_title": {"type": "string", "minLength": 1, "maxLength": 20},
    "subtitle": {"type": "string"},
    "author": {"type": "string"},
    "resolution": {
      "oneOf": [
        {"enum": ["high", "standard", "compact"]},
        {
          "type": "object",
          "required": ["width", "height"],
          "properties": {
            "width": {"type": "integer", "minimum": 64, "maximum": 16384},
            "height": {"type": "integer", "minimum": 64, "maximum": 16384},
            "safe_area": {"$ref": "#/$defs/safeArea"}
          },
          "anyOf": [
            {"required": ["safe_area"]},
            {
              "properties": {"width": {"const": 3200}, "height": {"const": 560}},
              "required": ["width", "height"]
            },
            {
              "properties": {"width": {"const": 1600}, "height": {"const": 280}},
              "required": ["width", "height"]
            },
            {
              "properties": {"width": {"const": 600}, "height": {"const": 200}},
              "required": ["width", "height"]
            }
          ],
          "allOf": [
            {
              "if": {
                "properties": {"width": {"const": 3200}, "height": {"const": 560}},
                "required": ["width", "height"]
              },
              "then": {
                "properties": {
                  "safe_area": {"const": {"x": 1020, "y": 0, "width": 1160, "height": 560}}
                }
              }
            },
            {
              "if": {
                "properties": {"width": {"const": 1600}, "height": {"const": 280}},
                "required": ["width", "height"]
              },
              "then": {
                "properties": {
                  "safe_area": {"const": {"x": 510, "y": 0, "width": 580, "height": 280}}
                }
              }
            },
            {
              "if": {
                "properties": {"width": {"const": 600}, "height": {"const": 200}},
                "required": ["width", "height"]
              },
              "then": {
                "properties": {
                  "safe_area": {"const": {"x": 90, "y": 16, "width": 420, "height": 168}}
                }
              }
            }
          ],
          "additionalProperties": false
        }
      ]
    },
    "composition_mode": {"enum": ["auto", "direct", "flow", "interlock"]},
    "subject_position": {"enum": ["left", "center", "right", "both", "none"]},
    "layering_requested": {"type": "boolean"},
    "commercial_context": {"type": "boolean"},
    "notes": {"type": "string"},
    "font": {"$ref": "#/$defs/rightsItem"},
    "source_assets": {
      "type": "array",
      "items": {"$ref": "#/$defs/rightsItem"}
    }
  },
  "$defs": {
    "safeArea": {
      "type": "object",
      "required": ["x", "y", "width", "height"],
      "properties": {
        "x": {"type": "integer", "minimum": 0},
        "y": {"type": "integer", "minimum": 0},
        "width": {"type": "integer", "minimum": 1},
        "height": {"type": "integer", "minimum": 1}
      },
      "additionalProperties": false
    },
    "rightsItem": {
      "type": "object",
      "required": ["rights_status"],
      "anyOf": [
        {"required": ["name"]},
        {"required": ["label"]}
      ],
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "name": {"type": "string", "minLength": 1},
        "label": {"type": "string"},
        "creator": {"type": "string"},
        "source": {"type": "string"},
        "rights_status": {
          "enum": [
            "owned",
            "explicit-permission",
            "licensed",
            "open",
            "public-domain",
            "unknown",
            "prohibited"
          ]
        },
        "commercial_allowed": {"type": "boolean"},
        "attribution": {"type": "string"},
        "attribution_required": {"type": "boolean"},
        "attribution_placement": {
          "enum": ["artwork", "metadata", "readme", "none"]
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
